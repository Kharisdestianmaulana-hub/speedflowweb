---
// src/components/CommunityCallout.astro
---

<section class="section-spacing" id="community">
  <div class="container">
    <div class="community-card pane">
      <div class="community-content">
        <span class="badge badge-brand" data-i18n="comm_badge">Open-Source Community</span>
        <h2 class="community-title" data-i18n="comm_title">Help shape the future of SpeedFlow</h2>
        <p class="community-desc" data-i18n="comm_subtitle">
          SpeedFlow is an open-source project created for people who want high download speeds without bloat or ads. Help us make it even better.
        </p>

        <div class="community-actions">
          <a
            href="https://github.com/Kharisdestianmaulana-hub/speedflow"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span data-i18n="comm_btn_star">Star on GitHub</span>
          </a>

          <a
            href="https://github.com/Kharisdestianmaulana-hub/speedflow/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span data-i18n="comm_btn_issues">Report an Issue</span>
          </a>

          <a
            href="https://github.com/Kharisdestianmaulana-hub/speedflow"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span data-i18n="comm_btn_source">View Source Code</span>
          </a>
        </div>

        <div class="community-tags font-mono">
          <span class="community-pill">
            <span class="text-brand">●</span> <span data-i18n="comm_pill1">100% Free & Open Source</span>
          </span>
          <span class="community-pill">
            <span class="text-brand">●</span> <span data-i18n="comm_pill2">Native Rust & Slint</span>
          </span>
          <span class="community-pill">
            <span class="text-brand">●</span> <span data-i18n="comm_pill3">Community-Driven</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
