---
// src/components/HowItWorks.astro
---

<section class="section-spacing" id="how-it-works">
  <div class="container">
    <div class="section-head-minimal">
      <span class="badge badge-brand" data-i18n="how_badge">How It Works</span>
      <h2 data-i18n="how_title">Ready in three simple steps</h2>
      <p data-i18n="how_subtitle">Start downloading faster without complicated setups or configurations.</p>
    </div>

    <!-- 3-Step Flat Grid -->
    <div class="how-grid">
      <!-- Step 01 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">01</span>
          <span class="badge badge-brand font-mono" data-i18n="how_step1_tag">Get App</span>
        </div>
        <h3 class="step-card-title" data-i18n="how_step1_title">Download SpeedFlow</h3>
        <p class="step-card-desc" data-i18n="how_step1_desc">
          Choose the setup installer or run the standalone portable version. No extra dependencies or runtimes required — it works immediately.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary" data-i18n="how_step1_meta">Installer (.exe) or Portable (.zip)</span>
        </div>
      </div>

      <!-- Step 02 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">02</span>
          <span class="badge badge-brand font-mono" data-i18n="how_step2_tag">Integrate</span>
        </div>
        <h3 class="step-card-title" data-i18n="how_step2_title">Catch Links Automatically</h3>
        <p class="step-card-desc" data-i18n="how_step2_desc">
          Install the free companion extension for Microsoft Edge, Firefox, or Chrome. Any download link you click is captured instantly.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary" data-i18n="how_step2_meta">1-Click Browser Catch</span>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">03</span>
          <span class="badge badge-brand font-mono" data-i18n="how_step3_tag">Accelerate</span>
        </div>
        <h3 class="step-card-title" data-i18n="how_step3_title">Download at Full Speed</h3>
        <p class="step-card-desc" data-i18n="how_step3_desc">
          SpeedFlow breaks your download into up to 32 parallel streams, maximizes your bandwidth, and safely resumes if your internet drops.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary" data-i18n="how_step3_meta">Up to 32 Parallel Streams</span>
        </div>
      </div>
    </div>
  </div>
</section>
