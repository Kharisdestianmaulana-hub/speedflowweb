---
// src/components/HowItWorks.astro
---

<section class="section-spacing" id="how-it-works">
  <div class="container">
    <div class="section-head-minimal">
      <span class="badge badge-brand">How It Works</span>
      <h2>Ready in three simple steps</h2>
      <p>Start downloading faster without complicated setups or configurations.</p>
    </div>

    <!-- 3-Step Flat Grid -->
    <div class="how-grid">
      <!-- Step 01 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">01</span>
          <span class="badge badge-brand font-mono">Get App</span>
        </div>
        <h3 class="step-card-title">Download SpeedFlow</h3>
        <p class="step-card-desc">
          Choose the setup installer or run the standalone portable version. No extra dependencies or runtimes required — it works immediately.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary">Installer (.exe) or Portable (.zip)</span>
        </div>
      </div>

      <!-- Step 02 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">02</span>
          <span class="badge badge-brand font-mono">Integrate</span>
        </div>
        <h3 class="step-card-title">Catch Links Automatically</h3>
        <p class="step-card-desc">
          Install the free companion extension for Microsoft Edge, Firefox, or Chrome. Any download link you click is captured instantly.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary">1-Click Browser Catch</span>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="step-card pane">
        <div class="step-card-header">
          <span class="step-num font-mono">03</span>
          <span class="badge badge-brand font-mono">Accelerate</span>
        </div>
        <h3 class="step-card-title">Download at Full Speed</h3>
        <p class="step-card-desc">
          SpeedFlow breaks your download into up to 32 parallel streams, maximizes your bandwidth, and safely resumes if your internet drops.
        </p>
        <div class="step-card-footer font-mono">
          <span class="text-tertiary">Up to 32 Parallel Streams</span>
        </div>
      </div>
    </div>
  </div>
</section>
