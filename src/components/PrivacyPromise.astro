---
// src/components/PrivacyPromise.astro
---

<section class="section-spacing" id="privacy">
  <div class="container">
    <div class="section-head-minimal">
      <span class="badge badge-brand" data-i18n="privacy_badge">Privacy & Clean Software</span>
      <h2 data-i18n="privacy_title">Built for you, not advertisers</h2>
      <p data-i18n="privacy_subtitle">SpeedFlow is designed to be honest, lightweight, and completely free from annoying bloat.</p>
    </div>

    <div class="privacy-grid">
      <!-- Item 1 -->
      <div class="privacy-card pane">
        <div class="privacy-card-header">
          <div class="privacy-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
          <span class="badge badge-brand font-mono" data-i18n="privacy_card1_tag">Zero Ads</span>
        </div>
        <h3 class="privacy-title" data-i18n="privacy_card1_title">No Ads, No Upsells</h3>
        <p class="privacy-desc" data-i18n="privacy_card1_desc">
          No intrusive license banners, fake download buttons, or third-party sponsor bundles. Just a clean, focused download manager that gets out of your way.
        </p>
      </div>

      <!-- Item 2 -->
      <div class="privacy-card pane">
        <div class="privacy-card-header">
          <div class="privacy-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <span class="badge badge-brand font-mono" data-i18n="privacy_card2_tag">Zero Tracking</span>
        </div>
        <h3 class="privacy-title" data-i18n="privacy_card2_title">No Data Telemetry</h3>
        <p class="privacy-desc" data-i18n="privacy_card2_desc">
          We never collect your browsing activity, download URLs, or personal usage statistics. Your downloads stay strictly between your PC and the file server.
        </p>
      </div>

      <!-- Item 3 -->
      <div class="privacy-card pane">
        <div class="privacy-card-header">
          <div class="privacy-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <span class="badge badge-brand font-mono" data-i18n="privacy_card3_tag">Local-First</span>
        </div>
        <h3 class="privacy-title" data-i18n="privacy_card3_title">Local-First Storage</h3>
        <p class="privacy-desc" data-i18n="privacy_card3_desc">
          All your download tasks, history, and custom settings live directly on your local hard drive. No cloud accounts, logins, or external dependencies required.
        </p>
      </div>

      <!-- Item 4 -->
      <div class="privacy-card pane">
        <div class="privacy-card-header">
          <div class="privacy-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="badge badge-brand font-mono" data-i18n="privacy_card4_tag">Open Source</span>
        </div>
        <h3 class="privacy-title" data-i18n="privacy_card4_title">Auditable Rust Code</h3>
        <p class="privacy-desc" data-i18n="privacy_card4_desc">
          100% of the codebase is open and publicly hosted on GitHub. Anyone can inspect the code, verify security, compile from source, or contribute.
        </p>
      </div>
    </div>
  </div>
</section>
