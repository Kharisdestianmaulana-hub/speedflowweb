---
// src/components/BrowserBridge.astro
---

<section class="section-spacing" id="extension">
  <div class="container">
    <div class="section-head-minimal">
      <span class="badge badge-brand" data-i18n="bridge_badge">Browser Extension</span>
      <h2 data-i18n="bridge_title">Catches downloads with one click</h2>
      <p data-i18n="bridge_subtitle">No more copying and pasting links. SpeedFlow grabs downloads directly from your browser.</p>
    </div>

    <!-- 2-Column Clean Flat Pane -->
    <div class="extension-flat-pane pane">
      <div class="extension-left">
        <span class="font-bold text-primary" style="font-size: 16px;" data-i18n="bridge_card_title">SpeedFlow for Your Browser</span>
        <p class="ext-desc" data-i18n-html="bridge_desc">
          Install the free companion extension for Microsoft Edge, Firefox, or Chrome. When you click to download files like <code>.zip</code>, <code>.iso</code>, <code>.exe</code>, or <code>.mp4</code>, SpeedFlow automatically starts downloading them at maximum speed.
        </p>

        <div class="ext-feature-points font-mono">
          <div class="ext-point">
            <span class="text-brand">✓</span>
            <span data-i18n="bridge_point1">Catches downloads automatically</span>
          </div>
          <div class="ext-point">
            <span class="text-brand">✓</span>
            <span data-i18n="bridge_point2">1-Click On/Off switch in toolbar</span>
          </div>
          <div class="ext-point">
            <span class="text-brand">✓</span>
            <span data-i18n="bridge_point3">Quick popup — never interrupts your browsing</span>
          </div>
        </div>

        <div class="browser-download-action">
          <a
            id="bridge-extension-btn"
            href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/download/v0.1.0-beta/speedflow-extension-v1.0.0.zip"
            download
            class="btn btn-primary btn-extension-dl"
            title="Download SpeedFlow Extension"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span data-i18n="bridge_btn">Download Extension (.zip)</span>
            <span class="btn-file-size font-mono" id="bridge-ext-size-tag">21 KB</span>
          </a>

          <!-- Extension Download Stats (Option 2) -->
          <div class="extension-option-meta font-mono">
            <span class="option-stat-chip">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span id="extension-downloads-count">16 downloads</span>
            </span>
            <span class="sep">•</span>
            <span class="option-tag-text" data-i18n="bridge_universal_meta">Universal .zip (Chrome, Edge, Firefox, Brave)</span>
          </div>
          <div class="bridge-guide-row">
            <span class="bridge-ext-note font-mono text-tertiary" data-i18n="bridge_compat">Works on Microsoft Edge, Google Chrome, Brave, and Mozilla Firefox</span>
            <a href="#extension-guide" class="bridge-guide-link font-mono">
              <span data-i18n="bridge_guide_link">View Browser Setup Guide ↓</span>
            </a>
          </div>
        </div>
      </div>

      <div class="extension-right">
        <div class="popup-frame">
          <img
            src="/extension-popup.png"
            alt="SpeedFlow Browser Extension Popup"
            class="popup-image"
            width="365"
            height="287"
          />
        </div>
      </div>
    </div>
  </div>
</section>
