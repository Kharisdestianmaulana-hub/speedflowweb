---
// src/components/DownloadSection.astro
---

<section class="section-spacing" id="download">
  <div class="container">
    <div class="section-head-minimal">
      <span class="badge badge-brand" data-i18n="dl_badge">Get SpeedFlow</span>
      <h2 data-i18n="dl_title">Start downloading at full speed</h2>
      <p data-i18n="dl_subtitle">Clean, native, and completely open source. No tracking, no ads.</p>
    </div>

    <div class="download-card pane">
      <div class="download-content">
        <!-- Release Badge Row -->
        <div class="badge-row">
          <div class="badge-tags-wrap">
            <span class="badge badge-brand" id="release-tag-badge">v0.1.0-beta</span>
            <span class="badge badge-warning" id="release-status-badge">Pre-release</span>
          </div>
          <span class="font-mono text-tertiary" id="release-date-text">Published: Nov 8, 2026</span>
        </div>

        <h3 class="download-title" data-i18n="dl_card_title">SpeedFlow for Windows</h3>
        <p class="download-desc" data-i18n="dl_card_desc">
          Super fast and lightweight download manager built with Rust. Compatible with Windows 10 and 11.
        </p>

        <!-- Direct Action Options (Option 2: Individual File Downloads Breakdown) -->
        <div class="download-options-grid">
          <!-- Installer Option -->
          <div class="download-option-unit">
            <a
              id="btn-download-installer"
              href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/download/v0.1.0-beta/SpeedFlow-Setup-v0.1.0.exe"
              class="btn btn-primary btn-lg btn-download-option"
              download
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span data-i18n="dl_btn_installer">Download Installer (.exe)</span>
              <span class="btn-file-size font-mono" id="installer-size-tag">6.6 MB</span>
            </a>
            <div class="download-option-meta font-mono">
              <span class="option-stat-chip">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span id="installer-downloads-count">23 downloads</span>
              </span>
              <span class="sep">•</span>
              <span class="option-tag-text" data-i18n="dl_opt_recommended">Recommended</span>
            </div>
          </div>

          <!-- Portable Option -->
          <div class="download-option-unit">
            <a
              id="btn-download-portable"
              href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/download/v0.1.0-beta/SpeedFlow-v0.1.0-Portable.zip"
              class="btn btn-secondary btn-lg btn-download-option"
              download
            >
              <span data-i18n="dl_btn_portable">Portable (.zip)</span>
              <span class="btn-file-size font-mono" id="portable-size-tag">6.3 MB</span>
            </a>
            <div class="download-option-meta font-mono">
              <span class="option-stat-chip">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span id="portable-downloads-count">9 downloads</span>
              </span>
              <span class="sep">•</span>
              <span class="option-tag-text" data-i18n="dl_opt_no_install">No install required</span>
            </div>
          </div>
        </div>

        <!-- Release Metadata & Stats Row -->
        <div class="download-meta-row font-mono">
          <span class="meta-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span id="total-downloads-count">Total: 48 downloads</span>
          </span>
          <span class="sep">•</span>
          <span data-i18n="dl_meta_verified">SHA-256 Verified</span>
          <span class="sep">•</span>
          <span>RAM: &lt; 35 MB</span>
          <span class="sep">•</span>
          <a href="/changelog" class="btn-archive-trigger font-mono" title="View changelog & past versions archive">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span data-i18n="dl_meta_older">Older Versions</span>
          </a>
          <span class="sep">•</span>
          <a
            id="release-github-link"
            href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/tag/v0.1.0-beta"
            target="_blank"
            rel="noopener noreferrer"
            class="release-gh-link"
          >
            <span data-i18n="dl_meta_gh">GitHub Release</span> ↗
          </a>
        </div>

        <!-- Option A: Collapsible Release Notes / Changelog Accordion -->
        <details class="release-notes-details" id="release-notes-accordion">
          <summary class="release-notes-summary font-mono">
            <span class="notes-summary-title">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              <span>What's new in <span id="notes-tag-label">v0.1.0-beta</span>?</span>
            </span>
            <span class="notes-toggle-icon font-mono">+</span>
          </summary>
          <div class="release-notes-body" id="release-notes-body">
            <h5 class="notes-heading">What is New in Beta:</h5>
            <ul class="notes-list">
              <li><strong>Multi-threaded Download Accelerator:</strong> Accelerate file downloads using up to 32 parallel connections.</li>
              <li><strong>Clean Flat Desktop Interface:</strong> Distraction-free high-density UI with light and dark theme modes.</li>
              <li><strong>Browser Integration:</strong> Seamless download interception ready for Google Chrome, Brave, Microsoft Edge, and Mozilla Firefox.</li>
              <li><strong>Smart File Categorization:</strong> Automatically sorts downloads into Documents, Videos, Music, Programs, and Archives.</li>
              <li><strong>Download Queue Management:</strong> Manage concurrent active tasks and queue waiting downloads automatically.</li>
              <li><strong>Background System Tray:</strong> Minimize to tray with native Windows notifications for download events.</li>
              <li><strong>Easy Onboarding Wizard:</strong> Interactive 4-step quick setup for first-time users.</li>
            </ul>
          </div>
        </details>
      </div>

      <!-- Developer Command Box -->
      <div class="dev-bar font-mono">
        <div class="dev-left">
          <span class="text-tertiary" data-i18n="dl_winget_label">Build from source:</span>
          <code class="text-brand">cargo run --release</code>
        </div>
        <button id="copy-btn-minimal" class="btn btn-ghost btn-sm" title="Copy command">
          <span id="copy-status" data-i18n="dl_winget_copy">Copy</span>
        </button>
      </div>
    </div>

    <!-- Option 1: Release Archive Modal Dialog -->
    <div id="archive-modal-backdrop" class="archive-modal-backdrop" aria-hidden="true">
      <div class="archive-modal-card" role="dialog" aria-modal="true" aria-labelledby="archive-modal-title">
        <div class="archive-modal-header">
          <div class="modal-title-wrap font-mono">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <h3 id="archive-modal-title" class="modal-title" data-i18n="modal_title">Release Archive</h3>
          </div>
          <button id="btn-close-archive-modal" class="modal-close-btn" aria-label="Close dialog">✕</button>
        </div>
        <div id="archive-modal-content" class="archive-modal-content">
          <!-- Populated dynamically by github-release.ts -->
          <div class="archive-empty-state">
            <div class="empty-icon-wrap" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="empty-badge">
              <span class="badge badge-brand font-mono">Initial Public Release</span>
            </div>
            <h4 class="empty-title" data-i18n="modal_empty_title">No Prior Releases Yet</h4>
            <p class="empty-desc" data-i18n="modal_empty_desc">
              This is the very first public release of SpeedFlow. As newer builds roll out, older versions will automatically be archived here.
            </p>
            <div class="empty-action">
              <a href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm font-mono">
                <span data-i18n="modal_empty_btn">View on GitHub Releases</span> ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/github-release';

  const copyBtn = document.getElementById('copy-btn-minimal');
  const copyStatus = document.getElementById('copy-status');
  if (copyBtn && copyStatus) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('cargo run --release').then(() => {
        copyStatus.textContent = 'Copied';
        setTimeout(() => {
          copyStatus.textContent = 'Copy';
        }, 1500);
      });
    });
  }
</script>
