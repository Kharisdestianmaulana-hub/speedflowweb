---
// src/components/Navbar.astro
---

<header class="navbar-wrapper">
  <div class="container navbar-inner">
    <!-- Brand + Version Tag -->
    <a href="#" class="brand-link">
      <img src="/LogoSpeedFlow.png" alt="SpeedFlow" width="22" height="22" class="brand-img" />
      <span class="brand-name">SpeedFlow</span>
      <span class="badge badge-brand nav-version-badge" id="nav-version-badge">v0.1.0-beta</span>
    </a>

    <!-- Desktop Nav Links (Clean 4 Core Links) -->
    <nav class="nav-links">
      <a href="#how-it-works" class="nav-item" data-i18n="nav_how_it_works">How It Works</a>
      <a href="#features" class="nav-item" data-i18n="nav_features">Features</a>
      <a href="#extension" class="nav-item" data-i18n="nav_extension">Extension</a>
      <a href="#faq" class="nav-item" data-i18n="nav_faq">FAQ</a>
    </nav>

    <!-- Right Actions -->
    <div class="nav-actions">
      <!-- Desktop GitHub Star Button -->
      <a
        id="desktop-gh-star-btn"
        href="https://github.com/Kharisdestianmaulana-hub/speedflow"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-gh-star-btn desktop-only"
        title="Star SpeedFlow on GitHub"
        aria-label="Star SpeedFlow on GitHub"
      >
        <svg class="gh-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span class="star-label" data-i18n="nav_star">Star</span>
        <svg class="star-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span id="nav-star-count" class="star-count font-mono">0</span>
      </a>

      <!-- Language Switcher (EN / ID) -->
      <div class="lang-switch-wrap font-mono" role="group" aria-label="Select Language">
        <button type="button" class="lang-btn active" data-lang="en" title="English">EN</button>
        <span class="lang-divider">/</span>
        <button type="button" class="lang-btn" data-lang="id" title="Bahasa Indonesia">ID</button>
      </div>

      <!-- Theme Switcher (Light/Dark) -->
      <button id="theme-toggle-btn" class="theme-toggle btn-ghost" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Desktop Download CTA -->
      <a
        id="nav-download-btn"
        href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/download/v0.1.0-beta/SpeedFlow-Setup-v0.1.0.exe"
        class="btn btn-primary btn-sm desktop-only"
        download
      >
        <span data-i18n="nav_download_btn">Download</span>
      </a>

      <!-- Hamburger Mega-Menu Toggle Button (Desktop & Mobile) -->
      <button
        id="mega-menu-toggle"
        class="menu-hamburger-btn"
        aria-label="Toggle Additional Menu & Ecosystem"
        aria-expanded="false"
        type="button"
        title="Menu Tambahan & Ekosistem"
      >
        <svg class="icon-hamburger" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mega Menu Dropdown Drawer (Inspired by Baku PDF) -->
  <div id="mega-menu-drawer" class="mega-menu-drawer" aria-hidden="true">
    <div class="container mega-menu-inner">
      <!-- Header Row: Title & Subtitle -->
      <div class="mega-menu-header font-mono">
        <span class="mega-header-title" data-i18n="drawer_section_title">MENU TAMBAHAN &amp; EKOSISTEM SPEEDFLOW</span>
        <span class="mega-header-sub text-tertiary desktop-only" data-i18n="drawer_section_sub">SpeedFlow — High-Performance Download Manager</span>
      </div>

      <!-- Mobile Navigation Core Links (Only visible on mobile screens) -->
      <div class="mobile-core-nav mobile-only">
        <div class="mobile-nav-pills font-mono">
          <a href="#how-it-works" class="drawer-nav-item" data-i18n="nav_how_it_works">How It Works</a>
          <a href="#features" class="drawer-nav-item" data-i18n="nav_features">Features</a>
          <a href="#extension" class="drawer-nav-item" data-i18n="nav_extension">Extension</a>
          <a href="#faq" class="drawer-nav-item" data-i18n="nav_faq">FAQ</a>
        </div>
      </div>

      <!-- 5-Card Ecosystem Grid (Desktop: 5 Columns, Mobile: Responsive Stack) -->
      <div class="mega-cards-grid">
        <!-- Card 1: Comparison -->
        <a href="#compare" class="mega-card pane drawer-nav-item">
          <div class="mega-card-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="17 1 21 5 17 9"></polyline>
              <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
              <polyline points="7 23 3 19 7 15"></polyline>
              <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
            </svg>
          </div>
          <div class="mega-card-info">
            <div class="mega-card-title-row">
              <strong class="mega-card-title" data-i18n="drawer_compare_title">Comparison</strong>
              <span class="mega-card-arrow">↗</span>
            </div>
            <p class="mega-card-desc" data-i18n="drawer_compare_desc">SpeedFlow vs IDM, Gopeed &amp; default browsers</p>
          </div>
        </a>

        <!-- Card 2: Extension Setup Guide -->
        <a href="#extension-guide" class="mega-card pane drawer-nav-item">
          <div class="mega-card-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="mega-card-info">
            <div class="mega-card-title-row">
              <strong class="mega-card-title" data-i18n="drawer_guide_title">Extension Setup Guide</strong>
              <span class="mega-card-arrow">↗</span>
            </div>
            <p class="mega-card-desc" data-i18n="drawer_guide_desc">Step-by-step setup for Chrome, Edge, and Firefox</p>
          </div>
        </a>

        <!-- Card 3: Privacy & Clean Software -->
        <a href="#privacy" class="mega-card pane drawer-nav-item">
          <div class="mega-card-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="mega-card-info">
            <div class="mega-card-title-row">
              <strong class="mega-card-title" data-i18n="drawer_privacy_title">Privacy &amp; Clean Software</strong>
              <span class="mega-card-arrow">↗</span>
            </div>
            <p class="mega-card-desc" data-i18n="drawer_privacy_desc">Zero ads, no data telemetry, 100% local-first</p>
          </div>
        </a>

        <!-- Card 4: Changelog & Archive -->
        <a href="#download" class="mega-card pane drawer-nav-item" id="mega-link-archive">
          <div class="mega-card-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <div class="mega-card-info">
            <div class="mega-card-title-row">
              <strong class="mega-card-title" data-i18n="drawer_changelog_title">Changelog &amp; Archive</strong>
              <span class="mega-card-arrow">↗</span>
            </div>
            <p class="mega-card-desc" data-i18n="drawer_changelog_desc">v0.1.0-beta release notes and past versions</p>
          </div>
        </a>

        <!-- Card 5: Community & Issues -->
        <a href="https://github.com/Kharisdestianmaulana-hub/speedflow/issues" target="_blank" rel="noopener noreferrer" class="mega-card pane drawer-nav-item">
          <div class="mega-card-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="mega-card-info">
            <div class="mega-card-title-row">
              <strong class="mega-card-title" data-i18n="drawer_community_title">Community &amp; Issues</strong>
              <span class="mega-card-arrow">↗</span>
            </div>
            <p class="mega-card-desc" data-i18n="drawer_community_desc">Report bugs, request features, or contribute on GitHub</p>
          </div>
        </a>
      </div>

      <!-- Mobile Actions Row (Download & Star CTA on mobile) -->
      <div class="mobile-mega-actions mobile-only">
        <a
          href="https://github.com/Kharisdestianmaulana-hub/speedflow"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-star-cta"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span class="mobile-star-label" data-i18n="nav_star_label">Star SpeedFlow on GitHub</span>
          <svg class="star-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span id="mobile-nav-star-count" class="star-count font-mono">0</span>
        </a>

        <a
          id="mobile-nav-download-btn"
          href="https://github.com/Kharisdestianmaulana-hub/speedflow/releases/download/v0.1.0-beta/SpeedFlow-Setup-v0.1.0.exe"
          class="btn btn-primary mobile-download-cta"
          download
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span data-i18n="nav_download_btn">Download</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--surface);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    max-width: 1200px !important;
    padding: 0 24px;
    gap: 16px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .brand-img {
    border-radius: 4px;
    flex-shrink: 0;
  }

  .brand-name {
    color: var(--text-primary);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .nav-version-badge {
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    font-size: 11px !important;
    padding: 2px 7px !important;
    margin-left: 2px;
  }

  /* 4 Core Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }

  .nav-item {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.12s ease;
    text-decoration: none;
    white-space: nowrap !important;
  }

  .nav-item:hover {
    color: var(--brand-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Language Switcher */
  .lang-switch-wrap {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 6px;
    height: 32px;
    background-color: var(--surface-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 11px;
    font-weight: 600;
  }

  .lang-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 2px 5px;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .lang-btn:hover {
    color: var(--text-primary);
  }

  .lang-btn.active {
    color: var(--brand-primary);
    background-color: var(--brand-subtle);
    font-weight: 700;
  }

  .lang-divider {
    color: var(--border-strong);
    font-size: 10px;
    user-select: none;
  }

  /* Theme Switcher */
  .theme-toggle {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    color: var(--text-secondary);
    border: 1px solid transparent;
    cursor: pointer;
    background: none;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background-color: var(--surface-hover);
    color: var(--text-primary);
    border-color: var(--border);
  }

  :global(html.dark) .sun-icon {
    display: block;
  }
  :global(html.dark) .moon-icon {
    display: none;
  }

  :global(html:not(.dark)) .sun-icon {
    display: none;
  }
  :global(html:not(.dark)) .moon-icon {
    display: block;
  }

  /* GitHub Star Button (Compact) */
  .nav-gh-star-btn {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    background-color: var(--surface-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
    gap: 6px;
    flex-shrink: 0;
  }

  .nav-gh-star-btn:hover {
    border-color: var(--brand-primary);
    color: var(--brand-primary);
    background-color: var(--surface-hover);
  }

  .star-icon {
    color: #FACC15;
    flex-shrink: 0;
  }

  .star-count {
    font-size: 11px;
    padding: 1px 5px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-secondary);
  }

  /* Hamburger Mega-Menu Button */
  .menu-hamburger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--surface-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .menu-hamburger-btn:hover {
    background-color: var(--surface-hover);
    border-color: var(--brand-primary);
    color: var(--brand-primary);
  }

  .menu-hamburger-btn.is-active {
    background-color: var(--surface-hover);
    border-color: var(--brand-primary);
    color: var(--brand-primary);
  }

  .menu-hamburger-btn .icon-close {
    display: none;
  }

  .menu-hamburger-btn.is-active .icon-hamburger {
    display: none;
  }

  .menu-hamburger-btn.is-active .icon-close {
    display: block;
  }

  /* Mega Menu Dropdown Drawer (Inspired by Baku PDF) */
  .mega-menu-drawer {
    display: none;
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
    animation: megaMenuSlideDown 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mega-menu-drawer.is-open {
    display: block;
  }

  @keyframes megaMenuSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mega-menu-inner {
    padding: 18px 24px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mega-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .mega-header-title {
    color: var(--brand-primary);
    font-weight: 700;
  }

  .mega-header-sub {
    font-size: 11px;
  }

  /* 5-Card Grid */
  .mega-cards-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .mega-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 14px 14px;
    border: 1px solid var(--border);
    background-color: var(--surface-secondary);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.15s ease;
  }

  .mega-card:hover {
    background-color: var(--surface-hover);
    border-color: var(--brand-primary);
    transform: translateY(-2px);
  }

  .mega-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--brand-primary);
    margin-bottom: 10px;
    transition: all 0.15s ease;
  }

  .mega-card:hover .mega-card-icon {
    border-color: var(--brand-primary);
    color: #fff;
    background-color: var(--brand-primary);
  }

  .mega-card-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .mega-card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .mega-card-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .mega-card-arrow {
    font-size: 12px;
    color: var(--text-tertiary);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .mega-card:hover .mega-card-arrow {
    color: var(--brand-primary);
    transform: translate(2px, -2px);
  }

  .mega-card-desc {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  /* Mobile Specific Elements */
