<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('speedflow-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('speedflow-theme', 'dark');
      }
    });
  }

  // Mega-Menu Hamburger Toggle Logic (Unified Desktop & Mobile)
  const megaToggle = document.getElementById('mega-menu-toggle');
  const megaDrawer = document.getElementById('mega-menu-drawer');
  const drawerLinks = document.querySelectorAll('.drawer-nav-item');

  function closeMegaMenu() {
    if (megaDrawer && megaToggle) {
      megaDrawer.classList.remove('is-open');
      megaToggle.classList.remove('is-active');
      megaToggle.setAttribute('aria-expanded', 'false');
      megaDrawer.setAttribute('aria-hidden', 'true');
    }
  }

  function toggleMegaMenu() {
    if (!megaDrawer || !megaToggle) return;
    const isOpen = megaDrawer.classList.toggle('is-open');
    megaToggle.classList.toggle('is-active', isOpen);
    megaToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    megaDrawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
  }

  if (megaToggle && megaDrawer) {
    megaToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMegaMenu();
    });

    // Close when clicking any nav item inside the drawer
    drawerLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMegaMenu();
      });
    });

    // Close when clicking outside of the navbar/drawer
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (megaDrawer.classList.contains('is-open') && !megaDrawer.contains(target) && !megaToggle.contains(target)) {
        closeMegaMenu();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && megaDrawer.classList.contains('is-open')) {
        closeMegaMenu();
      }
    });
  }
</script>
