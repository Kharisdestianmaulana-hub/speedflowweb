---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SpeedFlow — Desktop Download Manager & Accelerator",
  description = "High-performance native download manager built with Rust, Slint UI, and Tokio. Accelerated multi-connection downloads, smart queues, and browser extensions."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo/logo-32.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2A2D32" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme & Language initialization script (prevents flash of wrong theme/lang) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('speedflow-theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }

      const savedLang = localStorage.getItem('speedflow_lang');
      if (savedLang === 'id') {
        document.documentElement.lang = 'id';
      }
    </script>
  </head>
  <body>
    <slot />
    <script src="../scripts/i18n.ts"></script>
  </body>
</html>
