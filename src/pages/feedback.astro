<script>
  function initFeedbackPage() {
    const tabBugBtn = document.getElementById('tab-btn-bug');
    const tabFeatBtn = document.getElementById('tab-btn-feature');
    const tabContactBtn = document.getElementById('tab-btn-contact');
    const formBug = document.getElementById('form-bug') as HTMLFormElement | null;
    const formFeat = document.getElementById('form-feature') as HTMLFormElement | null;
    const contentContact = document.getElementById('tab-content-contact');

    const successCard = document.getElementById('feedback-success-card');
    const errorBanner = document.getElementById('feedback-error-banner');
    const errorMessageText = document.getElementById('error-message-text');
    const successIssueBadge = document.getElementById('success-issue-badge');
    const successIssueLink = document.getElementById('success-issue-link') as HTMLAnchorElement | null;
    const btnSubmitAnother = document.getElementById('btn-submit-another');

    let activeTab: 'bug' | 'feature' | 'contact' = 'bug';

    // 1. Tab Switching
    function setTab(target: 'bug' | 'feature' | 'contact') {
      activeTab = target;

      tabBugBtn?.classList.toggle('active', target === 'bug');
      tabBugBtn?.setAttribute('aria-selected', target === 'bug' ? 'true' : 'false');

      tabFeatBtn?.classList.toggle('active', target === 'feature');
      tabFeatBtn?.setAttribute('aria-selected', target === 'feature' ? 'true' : 'false');

      tabContactBtn?.classList.toggle('active', target === 'contact');
      tabContactBtn?.setAttribute('aria-selected', target === 'contact' ? 'true' : 'false');

      if (formBug) formBug.style.display = target === 'bug' ? 'flex' : 'none';
      if (formFeat) formFeat.style.display = target === 'feature' ? 'flex' : 'none';
      if (contentContact) contentContact.style.display = target === 'contact' ? 'flex' : 'none';

      // Hide status messages when switching tabs
      if (errorBanner) errorBanner.style.display = 'none';
    }

    tabBugBtn?.addEventListener('click', () => setTab('bug'));
    tabFeatBtn?.addEventListener('click', () => setTab('feature'));
    tabContactBtn?.addEventListener('click', () => setTab('contact'));

    // Check URL hash or query param for ?tab=contact or #contact
    if (window.location.hash === '#contact' || window.location.search.includes('tab=contact')) {
      setTab('contact');
    }

    // 2. Auto-detect OS from navigator
    if (typeof navigator !== 'undefined') {
      const ua = navigator.userAgent;
      const bugOsSelect = document.getElementById('bug-os') as HTMLSelectElement | null;
      if (bugOsSelect) {
        if (ua.includes('Windows NT 10.0')) {
          bugOsSelect.value = 'Windows 11 (64-bit)';
        } else if (ua.includes('Windows')) {
          bugOsSelect.value = 'Windows 10 (64-bit)';
        }
      }
    }

    // 3. Reset to another submission
    btnSubmitAnother?.addEventListener('click', () => {
      if (successCard) successCard.style.display = 'none';
      if (errorBanner) errorBanner.style.display = 'none';
      setTab(activeTab);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // 4. Form Submission Handler
    async function handleFormSubmit(form: HTMLFormElement, submitBtnId: string, originalBtnTextKey: string) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Checklist validation for Bug form
        if (form.id === 'form-bug') {
          const chkDup = document.getElementById('chk-bug-dup') as HTMLInputElement | null;
          const chkVer = document.getElementById('chk-bug-ver') as HTMLInputElement | null;
          if (chkDup && !chkDup.checked) {
            alert('Please check "I have confirmed this is not a duplicate issue" before submitting.');
            return;
          }
          if (chkVer && !chkVer.checked) {
            alert('Please check "I am using the latest released version" before submitting.');
            return;
          }
        }

        const submitBtn = document.getElementById(submitBtnId) as HTMLButtonElement | null;
        const btnTextSpan = submitBtn?.querySelector('.btn-text');
        const lang = document.documentElement.lang === 'id' ? 'id' : 'en';

        // Extract FormData
        const formData = new FormData(form);
        const payload: Record<string, any> = {};
        formData.forEach((value, key) => {
          payload[key] = value;
        });

        // Set Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnTextSpan) {
          btnTextSpan.textContent = lang === 'id' ? 'Sedang mengirim ke GitHub...' : 'Submitting to GitHub...';
        }
        if (errorBanner) errorBanner.style.display = 'none';

        try {
          const res = await fetch('/api/submit-issue', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const data = await res.json();

          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to submit issue to GitHub.');
          }

          // SUCCESS STATE
          form.reset();
          form.style.display = 'none';

          if (successCard) {
            successCard.style.display = 'block';
          }
          if (successIssueBadge) {
            successIssueBadge.textContent = `Issue #${data.issue_number}`;
          }
          if (successIssueLink && data.issue_url) {
            successIssueLink.href = data.issue_url;
          }

          // Scroll to success banner
          successCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        } catch (err: any) {
          console.error('[Feedback Submit Error]:', err);
          if (errorBanner) {
            errorBanner.style.display = 'flex';
          }
          if (errorMessageText) {
            errorMessageText.textContent = err.message || 'Network error or server unavailable.';
          }
          errorBanner?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (btnTextSpan) {
            const defaultText = lang === 'id'
              ? (form.id === 'form-bug' ? 'Kirim Laporan Bug' : 'Kirim Usulan Fitur')
              : (form.id === 'form-bug' ? 'Submit Bug Report' : 'Submit Feature Request');
            btnTextSpan.textContent = defaultText;
          }
        }
      });
    }

    if (formBug) handleFormSubmit(formBug, 'btn-submit-bug', 'fb_btn_submit_bug');
    if (formFeat) handleFormSubmit(formFeat, 'btn-submit-feat', 'fb_btn_submit_feat');
  }

  // Auto-init on DOM Ready
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFeedbackPage);
    } else {
      initFeedbackPage();
    }
  }
</script>
