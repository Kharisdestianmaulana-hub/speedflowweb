---
// src/pages/feedback.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Community Feedback & Issues — SpeedFlow"
  description="Report a bug or suggest a new feature for SpeedFlow. Your submission will be created directly as an official issue on our GitHub repository."
>
  <Navbar />

  <main class="feedback-page-wrapper">
    <div class="container feedback-container">
      <!-- Section Header -->
      <div class="section-head-minimal feedback-header">
        <div class="feedback-badge-wrap">
          <span class="badge badge-brand" data-i18n="fb_badge">Community &amp; Feedback</span>
        </div>
        <h1 class="feedback-main-title" data-i18n="fb_title">Report a Bug or Request a Feature</h1>
        <p class="feedback-main-sub" data-i18n="fb_subtitle">
          Submit feedback directly from your browser. Your report will be automatically logged to the official SpeedFlow GitHub repository.
        </p>
        <div class="feedback-external-link font-mono">
          <a
            href="https://github.com/Kharisdestianmaulana-hub/speedflow/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="gh-issues-pill"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span data-i18n="fb_view_gh">View issues on GitHub ↗</span>
          </a>
        </div>
      </div>

      <!-- Main Feedback Pane -->
      <div class="feedback-card pane">
        <!-- Tab Navigation -->
        <div class="feedback-tabs font-mono" role="tablist">
          <button
            type="button"
            class="feedback-tab-btn active"
            id="tab-btn-bug"
            data-target="bug"
            role="tab"
            aria-selected="true"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="8" height="14" x="8" y="6" rx="4"></rect>
              <path d="m19 7-3 2"></path>
              <path d="m5 7 3 2"></path>
              <path d="m19 19-3-2"></path>
              <path d="m5 19 3-2"></path>
              <path d="M20 13h-4"></path>
              <path d="M4 13h4"></path>
              <path d="m10 4 1 2"></path>
              <path d="m14 4-1 2"></path>
            </svg>
            <span data-i18n="fb_tab_bug">Report a Bug</span>
          </button>

          <button
            type="button"
            class="feedback-tab-btn"
            id="tab-btn-feature"
            data-target="feature"
            role="tab"
            aria-selected="false"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
              <path d="M9 18h6"></path>
              <path d="M10 22h4"></path>
            </svg>
            <span data-i18n="fb_tab_feature">Feature Request</span>
          </button>

          <button
            type="button"
            class="feedback-tab-btn"
            id="tab-btn-contact"
            data-target="contact"
            role="tab"
            aria-selected="false"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span data-i18n="fb_tab_contact">Contact &amp; Help</span>
          </button>
        </div>

        <!-- Success Result Card (Hidden by default) -->
        <div id="feedback-success-card" class="feedback-status-box success-box" style="display: none;">
          <div class="status-icon-circle success-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="status-title" data-i18n="fb_success_title">Submitted Successfully!</h3>
          <p class="status-desc">
            <span data-i18n="fb_success_desc">Your report has been logged to the SpeedFlow repository as</span>
            <strong id="success-issue-badge" class="font-mono text-brand">Issue #--</strong>.
          </p>
          <div class="status-actions">
            <a
              id="success-issue-link"
              href="https://github.com/Kharisdestianmaulana-hub/speedflow/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary font-mono"
            >
              <span data-i18n="fb_success_btn">View Issue on GitHub ↗</span>
            </a>
            <button type="button" id="btn-submit-another" class="btn btn-secondary font-mono">
              <span data-i18n="fb_success_another">Submit Another Report</span>
            </button>
          </div>
        </div>

        <!-- Error Result Alert (Hidden by default) -->
        <div id="feedback-error-banner" class="feedback-status-box error-box" style="display: none;">
          <div class="status-icon-circle error-circle">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="error-msg-content">
            <strong data-i18n="fb_error_title">Submission Failed</strong>
            <p id="error-message-text" class="font-mono text-secondary">An unexpected error occurred.</p>
          </div>
        </div>

        <!-- TAB 1: BUG REPORT FORM -->
        <form id="form-bug" class="feedback-form" novalidate>
          <input type="hidden" name="type" value="bug" />
          <!-- Anti-spam honeypot (Invisible to human, traps bots) -->
          <input type="text" name="website_url_hp" class="hp-field" tabindex="-1" autocomplete="off" />

          <!-- Pre-submission Checklist Box -->
          <div class="checklist-panel font-mono">
            <div class="checklist-head">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <strong data-i18n="fb_prereq_title">Pre-submission Checklist</strong>
            </div>
            <label class="check-item">
              <input type="checkbox" id="chk-bug-dup" required checked />
              <span data-i18n="fb_prereq_dup">I have confirmed this is not a duplicate issue.</span>
            </label>
            <label class="check-item">
              <input type="checkbox" id="chk-bug-ver" required checked />
              <span data-i18n="fb_prereq_ver">I am using the latest released version of SpeedFlow.</span>
            </label>
          </div>

          <!-- Bug Title -->
          <div class="form-group">
            <label for="bug-title" class="form-label font-mono">
              <span data-i18n="fb_label_title">Title</span> <span class="req">*</span>
            </label>
            <div class="input-prefix-wrap font-mono">
              <span class="input-prefix">[Bug]:</span>
              <input
                type="text"
                id="bug-title"
                name="title"
                class="form-input with-prefix"
                placeholder="Brief summary (e.g. Download stalls at 99%)"
                data-i18n-placeholder="fb_placeholder_bug_title"
                required
              />
            </div>
          </div>

          <!-- Describe the Bug -->
          <div class="form-group">
            <label for="bug-description" class="form-label font-mono">
              <span data-i18n="fb_label_desc">Describe the Bug</span> <span class="req">*</span>
            </label>
            <textarea
              id="bug-description"
              name="description"
              class="form-textarea"
              rows="4"
              placeholder="A clear and concise description of what happened..."
              data-i18n-placeholder="fb_placeholder_desc"
              required
            ></textarea>
          </div>

          <!-- Steps to Reproduce -->
          <div class="form-group">
            <label for="bug-steps" class="form-label font-mono">
              <span data-i18n="fb_label_steps">Steps to Reproduce</span> <span class="req">*</span>
            </label>
            <textarea
              id="bug-steps"
              name="steps"
              class="form-textarea font-mono"
              rows="4"
              placeholder="1. Open SpeedFlow&#10;2. Add download with URL...&#10;3. Observe error"
              data-i18n-placeholder="fb_placeholder_steps"
              required
            ></textarea>
          </div>

          <!-- Expected Behavior -->
          <div class="form-group">
            <label for="bug-expected" class="form-label font-mono">
              <span data-i18n="fb_label_expected">Expected Behavior</span> <span class="req">*</span>
            </label>
            <textarea
              id="bug-expected"
              name="expected"
              class="form-textarea"
              rows="3"
              placeholder="What did you expect to happen instead?"
              data-i18n-placeholder="fb_placeholder_expected"
              required
            ></textarea>
          </div>

          <!-- Environment 2x2 Grid -->
          <div class="form-grid-2col">
            <!-- OS -->
            <div class="form-group">
              <label for="bug-os" class="form-label font-mono">
                <span data-i18n="fb_label_os">Operating System</span> <span class="req">*</span>
              </label>
              <select id="bug-os" name="os" class="form-select font-mono" required>
                <option value="Windows 11 (64-bit)" selected>Windows 11 (64-bit)</option>
                <option value="Windows 10 (64-bit)">Windows 10 (64-bit)</option>
                <option value="Windows Server">Windows Server</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Package Type -->
            <div class="form-group">
              <label for="bug-package" class="form-label font-mono">
                <span data-i18n="fb_label_pkg">Package Type</span> <span class="req">*</span>
              </label>
              <select id="bug-package" name="packageType" class="form-select font-mono" required>
                <option value="Windows Installer (Setup.exe)" selected data-i18n="fb_pkg_installer">Windows Installer (Setup.exe)</option>
                <option value="Portable (.zip)" data-i18n="fb_pkg_portable">Portable (.zip)</option>
                <option value="Built from Source" data-i18n="fb_pkg_source">Built from Source</option>
              </select>
            </div>

            <!-- SpeedFlow Version -->
            <div class="form-group">
              <label for="bug-version" class="form-label font-mono">
                <span data-i18n="fb_label_ver">SpeedFlow Version</span> <span class="req">*</span>
              </label>
              <input
                type="text"
                id="bug-version"
                name="version"
                class="form-input font-mono"
                value="v0.1.0-beta"
                required
              />
            </div>

            <!-- Browser -->
            <div class="form-group">
              <label for="bug-browser" class="form-label font-mono">
                <span data-i18n="fb_label_browser">Browser (if related to extension)</span>
              </label>
              <select id="bug-browser" name="browser" class="form-select font-mono">
                <option value="None / Not Applicable" selected data-i18n="fb_browser_none">None / Not Applicable</option>
                <option value="Google Chrome">Google Chrome</option>
                <option value="Microsoft Edge">Microsoft Edge</option>
                <option value="Mozilla Firefox">Mozilla Firefox</option>
                <option value="Brave Browser">Brave Browser</option>
                <option value="Other Chromium Browser">Other Chromium Browser</option>
              </select>
            </div>
          </div>

          <!-- Screenshots or Logs -->
          <div class="form-group">
            <label for="bug-screenshots" class="form-label font-mono">
              <span data-i18n="fb_label_screenshots">Screenshots or Error Logs (Optional)</span>
            </label>
            <textarea
              id="bug-screenshots"
              name="screenshots"
              class="form-textarea font-mono"
              rows="3"
              placeholder="Paste error logs or image links here..."
              data-i18n-placeholder="fb_placeholder_screenshots"
            ></textarea>
          </div>

          <!-- Additional Context -->
          <div class="form-group">
            <label for="bug-additional" class="form-label font-mono">
              <span data-i18n="fb_label_additional">Additional Context (Optional)</span>
            </label>
            <textarea
              id="bug-additional"
              name="additional"
              class="form-textarea"
              rows="2"
              placeholder="Network type, antivirus, VPN, or any extra details..."
              data-i18n-placeholder="fb_placeholder_additional"
            ></textarea>
          </div>

          <!-- Reporter Name & Contact (Optional) -->
          <div class="form-grid-2col">
            <div class="form-group">
              <label for="bug-reporter" class="form-label font-mono">
                <span data-i18n="fb_label_reporter">Your Name or GitHub Handle (Optional)</span>
              </label>
              <input
                type="text"
                id="bug-reporter"
                name="reporterName"
                class="form-input"
                placeholder="e.g. John Doe / @johndoe"
                data-i18n-placeholder="fb_placeholder_reporter"
              />
            </div>
            <div class="form-group">
              <label for="bug-contact" class="form-label font-mono">
                <span data-i18n="fb_label_contact">Email or Contact (Optional)</span>
              </label>
              <input
                type="text"
                id="bug-contact"
                name="reporterContact"
                class="form-input"
                placeholder="For follow-up questions if needed"
                data-i18n-placeholder="fb_placeholder_contact"
              />
            </div>
          </div>

          <!-- Form Submit Button -->
          <div class="form-action-row">
            <button type="submit" id="btn-submit-bug" class="btn btn-primary btn-lg font-mono btn-submit-form">
              <svg class="submit-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span class="btn-text" data-i18n="fb_btn_submit_bug">Submit Bug Report</span>
            </button>
          </div>
        </form>

        <!-- TAB 2: FEATURE REQUEST FORM -->
        <form id="form-feature" class="feedback-form" style="display: none;" novalidate>
          <input type="hidden" name="type" value="feature" />
          <!-- Anti-spam honeypot -->
          <input type="text" name="website_url_hp" class="hp-field" tabindex="-1" autocomplete="off" />

          <!-- Feature Title -->
          <div class="form-group">
            <label for="feat-title" class="form-label font-mono">
              <span data-i18n="fb_label_title">Title</span> <span class="req">*</span>
            </label>
            <div class="input-prefix-wrap font-mono">
              <span class="input-prefix">[Feature]:</span>
              <input
                type="text"
                id="feat-title"
                name="title"
                class="form-input with-prefix"
                placeholder="Brief summary (e.g. Add OLED dark mode theme)"
                data-i18n-placeholder="fb_placeholder_feat_title"
                required
              />
            </div>
          </div>

          <!-- Problem Statement -->
          <div class="form-group">
            <label for="feat-problem" class="form-label font-mono">
              <span data-i18n="fb_label_problem">Problem Statement (Optional)</span>
            </label>
            <textarea
              id="feat-problem"
              name="problem"
              class="form-textarea"
              rows="3"
              placeholder="Is this request related to a specific limitation or pain point?"
              data-i18n-placeholder="fb_placeholder_problem"
            ></textarea>
          </div>

          <!-- Proposed Solution -->
          <div class="form-group">
            <label for="feat-solution" class="form-label font-mono">
              <span data-i18n="fb_label_solution">Proposed Solution / Idea</span> <span class="req">*</span>
            </label>
            <textarea
              id="feat-solution"
              name="proposedSolution"
              class="form-textarea"
              rows="4"
              placeholder="Describe the new capability or behavior you would like added to SpeedFlow..."
              data-i18n-placeholder="fb_placeholder_solution"
              required
            ></textarea>
          </div>

          <!-- Alternatives Considered -->
          <div class="form-group">
            <label for="feat-alternatives" class="form-label font-mono">
              <span data-i18n="fb_label_alternatives">Alternatives Considered (Optional)</span>
            </label>
            <textarea
              id="feat-alternatives"
              name="alternatives"
              class="form-textarea"
              rows="3"
              placeholder="In other download managers, this is handled by..."
              data-i18n-placeholder="fb_placeholder_alternatives"
            ></textarea>
          </div>

          <!-- Additional Context or Mockups -->
          <div class="form-group">
            <label for="feat-additional" class="form-label font-mono">
              <span data-i18n="fb_label_additional">Additional Context or Mockups (Optional)</span>
            </label>
            <textarea
              id="feat-additional"
              name="additional"
              class="form-textarea"
              rows="3"
              placeholder="Network type, screenshots, mockups, or any extra details..."
              data-i18n-placeholder="fb_placeholder_additional"
            ></textarea>
          </div>

          <!-- Reporter Name & Contact (Optional) -->
          <div class="form-grid-2col">
            <div class="form-group">
              <label for="feat-reporter" class="form-label font-mono">
                <span data-i18n="fb_label_reporter">Your Name or GitHub Handle (Optional)</span>
              </label>
              <input
                type="text"
                id="feat-reporter"
                name="reporterName"
                class="form-input"
                placeholder="e.g. John Doe / @johndoe"
                data-i18n-placeholder="fb_placeholder_reporter"
              />
            </div>
            <div class="form-group">
              <label for="feat-contact" class="form-label font-mono">
                <span data-i18n="fb_label_contact">Email or Contact (Optional)</span>
              </label>
              <input
                type="text"
                id="feat-contact"
                name="reporterContact"
                class="form-input"
                placeholder="For follow-up questions if needed"
                data-i18n-placeholder="fb_placeholder_contact"
              />
            </div>
          </div>

          <!-- Form Submit Button -->
          <div class="form-action-row">
            <button type="submit" id="btn-submit-feat" class="btn btn-primary btn-lg font-mono btn-submit-form">
              <svg class="submit-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span class="btn-text" data-i18n="fb_btn_submit_feat">Submit Feature Request</span>
            </button>
          </div>
        </form>

        <!-- TAB 3: CONTACT & HELP (Direct Developer Channels + Troubleshooting) -->
        <div id="tab-content-contact" class="contact-tab-pane" style="display: none;">
          <!-- Section Heading -->
          <div class="contact-pane-head">
            <h3 class="contact-heading" data-i18n="contact_section_title">Direct Developer Channels</h3>
            <p class="contact-subhead" data-i18n="contact_section_sub">
              Need personal help, want to discuss SpeedFlow development, or have a partnership idea? Reach out directly via Telegram or Discord.
            </p>
          </div>

          <!-- Direct Channels Grid -->
          <div class="contact-channels-grid">
            <!-- Telegram Card -->
            <div class="contact-channel-card pane">
              <div class="channel-card-top">
                <div class="channel-icon-wrap tg-icon-wrap">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                </div>
                <span class="badge badge-brand font-mono" data-i18n="contact_tg_badge">Fast Response</span>
              </div>
              <h4 class="channel-name" data-i18n="contact_tg_title">Telegram</h4>
              <span class="channel-handle font-mono text-tertiary">@Kharisdm</span>
              <p class="channel-desc" data-i18n="contact_tg_desc">
                Chat directly on Telegram for real-time questions, feedback, or developer discussions.
              </p>
              <div class="channel-action">
                <a
                  href="http://t.me/Kharisdm"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary font-mono btn-channel-link"
                >
                  <span data-i18n="contact_tg_btn">Chat on Telegram →</span>
                </a>
              </div>
            </div>

            <!-- Discord Card -->
            <div class="contact-channel-card pane">
              <div class="channel-card-top">
                <div class="channel-icon-wrap dc-icon-wrap">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="12" x="3" y="6" rx="2"></rect>
                    <line x1="7" y1="12" x2="7.01" y2="12"></line>
                    <line x1="17" y1="12" x2="17.01" y2="12"></line>
                    <path d="M12 9v6"></path>
                    <path d="M9 12h6"></path>
                  </svg>
                </div>
                <span class="badge badge-warning font-mono" data-i18n="contact_dc_badge">Community &amp; Tech</span>
              </div>
              <h4 class="channel-name" data-i18n="contact_dc_title">Discord</h4>
              <span class="channel-handle font-mono text-tertiary">ID: 1374621376706777179</span>
              <p class="channel-desc" data-i18n="contact_dc_desc">
                Connect on Discord for technical consulting, Rust development topics, or casual developer chats.
              </p>
              <div class="channel-action">
                <a
                  href="https://discord.com/users/1374621376706777179"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary font-mono btn-channel-link"
                >
                  <span data-i18n="contact_dc_btn">Open Discord Profile →</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Divider -->
          <div class="contact-divider"></div>

          <!-- Quick Self-Service Troubleshooting Section -->
          <div class="contact-troubleshoot-wrapper">
            <div class="troubleshoot-head">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <div>
                <h4 class="troubleshoot-title" data-i18n="contact_faq_title">Quick Self-Service Troubleshooting</h4>
                <p class="troubleshoot-sub" data-i18n="contact_faq_sub">
                  Solve common questions instantly without waiting for a reply:
                </p>
              </div>
            </div>

            <div class="troubleshoot-cards-grid">
              <div class="troubleshoot-item pane">
                <strong class="troubleshoot-q" data-i18n="contact_q1_title">1. Download not intercepted from browser?</strong>
                <p class="troubleshoot-a" data-i18n="contact_q1_desc">
                  Check that the SpeedFlow companion extension is enabled in your browser toolbar and the SpeedFlow desktop application is running.
                </p>
              </div>

              <div class="troubleshoot-item pane">
                <strong class="troubleshoot-q" data-i18n="contact_q2_title">2. Download paused or stalls near 99%?</strong>
                <p class="troubleshoot-a" data-i18n="contact_q2_desc">
                  Click Pause, wait 3 seconds, then click Resume. SpeedFlow will automatically verify and reconnect any lagging stream parts.
                </p>
              </div>

              <div class="troubleshoot-item pane">
                <strong class="troubleshoot-q" data-i18n="contact_q3_title">3. Download link expired while paused?</strong>
                <p class="troubleshoot-a" data-i18n="contact_q3_desc">
                  Copy the renewed link from your browser, right-click the paused task in SpeedFlow, and select 'Renew URL' to continue seamlessly.
                </p>
              </div>

              <div class="troubleshoot-item pane">
                <strong class="troubleshoot-q" data-i18n="contact_q4_title">4. Windows SmartScreen warning appeared?</strong>
