---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import PrivacyPromise from '../components/PrivacyPromise.astro';
import BrowserBridge from '../components/BrowserBridge.astro';
import ExtensionGuide from '../components/ExtensionGuide.astro';
import DownloadSection from '../components/DownloadSection.astro';
import CommunityCallout from '../components/CommunityCallout.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
---

<Layout
  title="SpeedFlow — Minimalist Desktop Download Accelerator"
  description="Native desktop download manager built with Rust, Slint UI, and Tokio. Multi-stream parallel acceleration with pause and resume."
>
  <Navbar />
  <main>
    <Hero />
    <HowItWorks />
    <FeaturesGrid />
    <ComparisonTable />
    <PrivacyPromise />
    <BrowserBridge />
    <ExtensionGuide />
    <DownloadSection />
    <CommunityCallout />
    <Faq />
  </main>
  <Footer />
  <BackToTop />
</Layout>
